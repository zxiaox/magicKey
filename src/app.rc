#include <windows.h>
#include "app_config.hpp"
1 RT_MANIFEST "app.manifest"
2 RCDATA "THIRD-PARTY-NOTICES.txt"
1 VERSIONINFO
FILEVERSION MAGICKEY_VERSION_COMMAS
PRODUCTVERSION MAGICKEY_VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MagicKey"
      VALUE "FileDescription", "MagicKey portable keyboard remapper"
      VALUE "FileVersion", MAGICKEY_VERSION
      VALUE "InternalName", "MagicKey"
      VALUE "OriginalFilename", "MagicKey.exe"
      VALUE "ProductName", "MagicKey"
      VALUE "ProductVersion", MAGICKEY_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
